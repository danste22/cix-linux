# Derived from pinned CIX config/config-7.3.defconfig over Debian's generated
# arm64 configuration. All requested symbols resolve on 7.2.
# BRIDGE and EXT4_FS stay at Debian's =m. The CIX =y values empty
# ext4-modules (it needs ext4.ko) and are not required for O6N boot.
# Overrides that only changed Debian for devices this board does not use
# are not listed here, so Debian's value remains.
CONFIG_ARM64_PA_BITS=48
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM_DMA350=m
CONFIG_BCH=y
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_CGROUP_FAVOR_DYNMODS=y
CONFIG_CIX_DSP=m
CONFIG_CIX_DSP_RPROC=y
CONFIG_CIX_DST=y
CONFIG_CIX_MBOX=y
CONFIG_CIX_THERMAL=y
CONFIG_CLK_SKY1_AUDSS=y
CONFIG_CRC16=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DMABUF_HEAPS=y
CONFIG_DRM_CIX=m
CONFIG_DRM_CIX_EDP_PANEL=m
CONFIG_DRM_TRILIN_DPSUB=m
CONFIG_EXT4_FS=m
CONFIG_GPIO_CADENCE=y
CONFIG_I2C_CADENCE=y
CONFIG_LD_ORPHAN_WARN_LEVEL="error"
CONFIG_LLC=y
CONFIG_NETFILTER_XTABLES_COMPAT=y
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NTFS3_FS=m
CONFIG_PCI_SKY1_HOST_CIX=y
CONFIG_PGTABLE_LEVELS=4
CONFIG_PHY_CIX_PCIE=y
CONFIG_PHY_CIX_USB2=y
CONFIG_PHY_CIX_USB3=y
CONFIG_PHY_CIX_USBDP=y
CONFIG_PWM_SKY1=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RESET_SKY1=y
CONFIG_RESET_SKY1_AUDSS=y
CONFIG_RTC_DRV_RX8900=y
CONFIG_SKY1_GPT_TIMER=y
CONFIG_SND_HDA_CIX_IPBLOQ=m
CONFIG_SND_SOC_CDNS_I2S_MC=m
CONFIG_SND_SOC_CDNS_I2S_SC=m
CONFIG_SND_SOC_CIX=m
CONFIG_SND_SOC_SOF_CIX_TOPLEVEL=y
CONFIG_STP=y
CONFIG_TYPEC=y
CONFIG_TYPEC_RTS5453=y
CONFIG_USB=y
CONFIG_USB_CDNS3=y
CONFIG_USB_CDNS_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_GADGET=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_WERROR=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_842_COMPRESS=m
CONFIG_842_DECOMPRESS=m
CONFIG_ARM64_PA_BITS_48=y
CONFIG_BRIDGE_EBT_BROUTE=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m
# CONFIG_CIX_EC_EXCEPTION_DRIVER is not set
CONFIG_CIX_SCMI_ENERGY_MODEL=m
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# CONFIG_DMABUF_HEAPS_SYSTEM_CC_SHARED is not set
CONFIG_DRM_CIX_VIRTUAL=m
CONFIG_DRM_LINLONDP=m
# CONFIG_DRM_LINLONDP_CLOCK_FIXED is not set
# CONFIG_DRM_TRILIN_CADENCE_PHY is not set
CONFIG_DRM_TRILIN_DP_CIX=m
# CONFIG_NTFS3_64BIT_CLUSTER is not set
# CONFIG_NTFS3_FS_POSIX_ACL is not set
# CONFIG_NTFS3_LZX_XPRESS is not set
CONFIG_OPTEE_STATIC_PROTMEM_POOL=y
CONFIG_PLAT_AP_HOOK=y
CONFIG_PLAT_BBOX=y
CONFIG_PLAT_BBOX_BCH_M=9
CONFIG_PLAT_BBOX_BCH_T=4
# CONFIG_PLAT_BOOT_POSTCODE is not set
# CONFIG_PLAT_BOOT_TIME is not set
# CONFIG_PLAT_CACHE_EXCEPTION_MONITOR is not set
# CONFIG_PLAT_CACHE_EXCEPTION_MONITOR_TEST is not set
# CONFIG_PLAT_DSM is not set
# CONFIG_PLAT_DSM_TEST is not set
CONFIG_PLAT_HW_BREAKPOINT=y
# CONFIG_PLAT_IDM_DETECT is not set
# CONFIG_PLAT_LOGGER is not set
# CONFIG_PLAT_MNTNDUMP is not set
# CONFIG_PLAT_PRINTK_EXT is not set
CONFIG_PLAT_REBOOT_REASON=y
# CONFIG_PLAT_SKY1_AUDIO_TIMEOUT is not set
# CONFIG_PLAT_SKY1_RCSU_GASKET_ERROR is not set
# CONFIG_PLAT_TEE_EXCEPTIONS is not set
# CONFIG_PLAT_TFA_TRACE is not set
# CONFIG_PLAT_TZC400_DETECT is not set
# CONFIG_PM_EXCEPTION_DRIVER is not set
# CONFIG_PM_EXCEPTION_PROTOCOL is not set
# CONFIG_PM_EXCP_DSM_DRIVER is not set
CONFIG_SKY1_REBOOT_REASON=y
# CONFIG_SND_SOC_SOF_CIX_SKY1 is not set
CONFIG_TEE_DMABUF_HEAPS=y
# CONFIG_ZRAM_DEF_COMP_842 is not set
# CONFIG_ZRAM_DEF_COMP_LZO is not set
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
